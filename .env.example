# Multi-bot credentials are stored in config/bots.local.json on your Mac.
# In a cloud deployment, put the same JSON in the FEISHU_BOTS_JSON secret.
FEISHU_BOTS_FILE=config/bots.local.json
FEISHU_BOTS_JSON=
FEISHU_OWNER_OPEN_ID=
FEISHU_BITABLE_APP_TOKEN=

# Any OpenAI-compatible Chat Completions endpoint can be used later.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

PORT=4280
HOST=127.0.0.1

